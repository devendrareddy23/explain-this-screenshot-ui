* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
    sans-serif;
  background: #0b1020;
  color: #f5f7fb;
}

button,
input,
textarea,
select {
  font: inherit;
}

a {
  color: inherit;
  text-decoration: none;
}

.app-shell {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 320px 1fr;
  background:
    radial-gradient(circle at top left, rgba(91, 141, 239, 0.18), transparent 30%),
    radial-gradient(circle at bottom right, rgba(36, 211, 182, 0.12), transparent 25%),
    #0b1020;
}

.sidebar {
  border-right: 1px solid rgba(255, 255, 255, 0.08);
  padding: 28px 20px;
  background: rgba(8, 12, 24, 0.78);
  backdrop-filter: blur(12px);
}

.brand-block h1 {
  margin: 8px 0 10px;
  font-size: 28px;
  line-height: 1.15;
}

.brand-subtext {
  margin: 0;
  color: #aeb9d6;
  line-height: 1.6;
}

.eyebrow {
  margin: 0;
  color: #67e8f9;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-weight: 700;
}

.status-card,
.value-card,
.upgrade-card {
  margin-top: 20px;
  padding: 18px;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.status-card p,
.value-card p,
.upgrade-card p {
  margin: 0 0 12px;
  color: #dbe4ff;
}

.status-card span {
  display: block;
  font-size: 12px;
  color: #94a3c7;
  margin-bottom: 4px;
}

.status-card strong {
  display: block;
  font-size: 14px;
  word-break: break-word;
}

.plan-pro {
  color: #34d399;
}

.plan-free {
  color: #fbbf24;
}

.status-actions {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 16px;
}

.value-card h3,
.upgrade-card h3 {
  margin-top: 0;
}

.value-card ol {
  margin: 0;
  padding-left: 20px;
  color: #dbe4ff;
  line-height: 1.8;
}

.primary-link-btn,
.primary-btn,
.secondary-btn,
.ghost-btn,
.secondary-link-btn {
  border: none;
  border-radius: 14px;
  padding: 12px 16px;
  cursor: pointer;
  transition: 0.2s ease;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

.primary-btn,
.primary-link-btn {
  background: linear-gradient(135deg, #4f46e5, #06b6d4);
  color: white;
  box-shadow: 0 10px 30px rgba(6, 182, 212, 0.22);
}

.primary-btn:hover,
.primary-link-btn:hover {
  transform: translateY(-1px);
}

.secondary-btn,
.secondary-link-btn {
  background: rgba(255, 255, 255, 0.06);
  color: #f5f7fb;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.ghost-btn {
  background: transparent;
  color: #c5d0eb;
  border: 1px dashed rgba(255, 255, 255, 0.14);
}

.primary-btn:disabled,
.secondary-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none;
}

.main-content {
  padding: 28px;
}

.hero-card,
.panel-card {
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 22px;
  margin-bottom: 22px;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.18);
}

.hero-card h2,
.panel-card h3 {
  margin-top: 8px;
  margin-bottom: 8px;
}

.hero-card p,
.panel-card p {
  color: #b7c3df;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 18px;
}

.panel-tag {
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(103, 232, 249, 0.12);
  color: #67e8f9;
  font-size: 12px;
  font-weight: 700;
}

.resume-textarea,
.output-textarea,
.field input,
.field select {
  width: 100%;
  border-radius: 16px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(6, 10, 20, 0.6);
  color: #f8fbff;
}

.resume-textarea,
.output-textarea {
  min-height: 260px;
  padding: 16px;
  line-height: 1.6;
  resize: vertical;
}

.search-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr 180px auto auto;
  gap: 14px;
  align-items: end;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.field label,
.checkbox-field label {
  font-size: 13px;
  color: #aeb9d6;
  font-weight: 600;
}

.field input,
.field select {
  padding: 14px 16px;
  min-height: 50px;
}

.checkbox-field {
  display: flex;
  align-items: center;
  gap: 10px;
  padding-bottom: 10px;
}

.jobs-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.job-card {
  border-radius: 20px;
  padding: 18px;
  background: rgba(6, 10, 20, 0.56);
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.job-top {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: flex-start;
}

.job-top h4 {
  margin: 0 0 6px;
  font-size: 18px;
  line-height: 1.35;
}

.job-company {
  margin: 0;
  color: #8fb3ff;
  font-weight: 700;
}

.job-meta {
  margin-top: 12px;
  font-size: 13px;
  color: #9fb0d0;
}

.job-desc {
  margin-top: 14px;
  color: #cdd8ef;
  line-height: 1.6;
}

.score-badge {
  white-space: nowrap;
  border-radius: 999px;
  padding: 8px 12px;
  font-size: 12px;
  font-weight: 800;
}

.score-good {
  background: rgba(52, 211, 153, 0.14);
  color: #34d399;
}

.score-mid {
  background: rgba(251, 191, 36, 0.14);
  color: #fbbf24;
}

.score-low {
  background: rgba(248, 113, 113, 0.14);
  color: #f87171;
}

.job-actions {
  margin-top: 16px;
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.workspace-grid {
  display: grid;
  grid-template-columns: 320px 1fr;
  gap: 18px;
}

.workspace-summary,
.workspace-output {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.summary-box,
.output-card,
.empty-state {
  border-radius: 20px;
  padding: 18px;
  background: rgba(6, 10, 20, 0.56);
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.summary-label {
  margin-top: 0;
  color: #67e8f9;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-weight: 700;
}

.workspace-action-stack {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.output-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.output-header h4 {
  margin: 0;
}

.output-header span {
  font-size: 12px;
  color: #9fb0d0;
  font-weight: 700;
}

.error-text {
  color: #fda4af;
  margin-top: 14px;
  font-weight: 700;
}

.empty-state p {
  margin: 0;
  color: #9fb0d0;
}

@media (max-width: 1200px) {
  .search-grid {
    grid-template-columns: 1fr 1fr;
  }

  .jobs-grid {
    grid-template-columns: 1fr;
  }

  .workspace-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 900px) {
  .app-shell {
    grid-template-columns: 1fr;
  }

  .sidebar {
    border-right: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .main-content {
    padding: 18px;
  }

  .search-grid {
    grid-template-columns: 1fr;
  }
}

.jobs-tab {
  display: grid;
  gap: 20px;
}

.section-card {
  background: #111827;
  border: 1px solid #1f2937;
  border-radius: 14px;
  padding: 20px;
  margin-bottom: 20px;
}

.section-card h2,
.section-card h3,
.section-card h4 {
  margin-top: 0;
  color: #ffffff;
}

.section-card p,
.section-card label {
  color: #d1d5db;
}

.jobs-form {
  display: grid;
  gap: 14px;
  margin-top: 16px;
}

.form-group {
  display: grid;
  gap: 6px;
}

.form-group input {
  padding: 12px;
  border-radius: 10px;
  border: 1px solid #374151;
  background: #0f172a;
  color: white;
}

.checkbox-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.jobs-list {
  display: grid;
  gap: 14px;
  margin-top: 16px;
}

.job-card {
  border: 1px solid #374151;
  border-radius: 12px;
  padding: 16px;
  background: #0b1220;
}

.job-link {
  display: inline-block;
  margin-top: 10px;
  color: #60a5fa;
  text-decoration: none;
  font-weight: 600;
}

.job-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 14px;
}

.secondary-btn {
  background: transparent;
  border: 1px solid #4b5563;
  color: white;
}

.status-error {
  margin-top: 12px;
  padding: 12px;
  border-radius: 10px;
  background: rgba(220, 38, 38, 0.15);
  border: 1px solid rgba(220, 38, 38, 0.4);
  color: #fca5a5;
}

.status-success {
  margin-top: 12px;
  padding: 12px;
  border-radius: 10px;
  background: rgba(22, 163, 74, 0.15);
  border: 1px solid rgba(22, 163, 74, 0.4);
  color: #86efac;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}
